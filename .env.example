# Folder that contains the PlantVillage class folders (relative to project root, or absolute)
DATASET_DIR=data/plantvillage

# Image size the network sees (128 is faster, 224 keeps more detail)
IMAGE_SIZE=128

# Training settings
BATCH_SIZE=32
EPOCHS=40
LEARNING_RATE=0.001
WEIGHT_DECAY=0.0001
DROPOUT=0.3
SEED=42

# Stop if validation loss hasn't improved for this many epochs
EARLY_STOPPING_PATIENCE=7

# Halve the learning rate if validation loss hasn't improved for this many epochs
LR_PATIENCE=3
LR_FACTOR=0.5

# Background processes that load images while the GPU trains.
# Set to 0 if you get errors about workers or multiprocessing.
NUM_WORKERS=4

# Split fractions (train gets whatever is left)
VAL_SPLIT=0.15
TEST_SPLIT=0.15
# Folder names to skip, comma-separated (leave empty to use everything)
EXCLUDE_DIRS=